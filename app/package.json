{
  "name": "raidtrack-base",
  "version": "1.0.0",
  "description": "RaidTrack — app da estação base",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "cap:android": "npm run build && (npx cap add android || echo ja-existe) && npx cap sync android && npx cap open android",
    "cap:ios": "npm run build && (npx cap add ios || echo ja-existe) && npx cap sync ios && npx cap open ios",
    "build:demo": "tsc && vite build --mode demo",
    "test": "tsx test/settings.test.ts && tsx test/telemetria.test.ts && tsx test/geo.test.ts && tsx test/plan.test.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/core": "^8.6.0",
    "@meshtastic/core": "2.6.7",
    "@meshtastic/transport-web-bluetooth": "^0.1.5",
    "@meshtastic/transport-web-serial": "^0.2.5",
    "esptool-js": "^0.7.1",
    "jspdf": "^3.0.4",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@meshtastic/protobufs": "^2.7.8",
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/qrcode": "^1.5.6",
    "@types/w3c-web-serial": "^1.0.9",
    "@types/web-bluetooth": "^0.0.22",
    "jsdom": "^31.0.0",
    "ste-simple-events": "^4.0.0",
    "tslog": "^5.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "private": true,
  "type": "module"
}
